# ============================================================================
# XYZ Games — Production Environment Configuration Template (.env.example)
# Copy this file to `.env` for local development or configure these variables
# in your Render Dashboard -> Environment.
# NEVER commit a real `.env` file or live service-role keys to Git!
# ============================================================================

# 1. Server Runtime & Environment
NODE_ENV=production
PORT=4000

# 2. Cryptographic Secrets (REQUIRED in production — minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_CSPRNG_SECRET_KEY_MINIMUM_32_CHARS
WINGO_MASTER_SEED=REPLACE_WITH_64_HEX_CHAR_PROVABLY_FAIR_HMAC_SEED
WEBHOOK_HMAC_SECRET=REPLACE_WITH_64_HEX_CHAR_PAYMENT_WEBHOOK_HMAC_SECRET

# 3. Strict CORS Origin Allowlist (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=https://xyzgames.app,https://www.xyzgames.app,https://xyz-games.onrender.com

# 4. SQLite3 WAL Persistent Disk Path (Render persistent disk or local directory)
XYZ_DATA_DIR=/var/data

# 5. Optional Supabase PostgreSQL Cloud Sync Bridge (Backend-Only Service Role)
# Leave blank if running purely on SQLite3 WAL. Never expose SUPABASE_SERVICE_ROLE_KEY to browsers!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_SECRET_KEY
