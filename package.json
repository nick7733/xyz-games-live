  "description": "XYZ Games — Zero-Dependency Multi-Device Real-Time Cloud Sync Server, Customer Webapp (index.html), and Super Admin Panel (admin_panel.html)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
